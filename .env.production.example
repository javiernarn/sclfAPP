# =============================================================================
# SCLF: PRODUCTION .env EXAMPLE (Hostinger shared hosting)
# =============================================================================
# HOW TO USE
#  1. Copy this file to the SERVER and rename it to  .env  (do it in hPanel
#     File Manager or over SSH/FTP, inside the project folder, NOT in public/).
#  2. Replace every  CHANGE_ME  value. Nothing in this file is a real secret.
#  3. Never upload your local .env, never commit .env, never share it.
#  4. File permissions on the server: 600 (owner read/write only).
#  5. After editing .env on the server run:
#         php artisan config:clear && php artisan config:cache
#
# Lines marked [REQUIRED] must be set. Others are safe defaults.
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME="SCLF"
# [REQUIRED] must be exactly "production" (turns on the strict behaviour).
APP_ENV=production
# [REQUIRED] must be false. true leaks stack traces and configuration to visitors.
APP_DEBUG=false
# [REQUIRED] your real address, with https. Used in email links and QR codes.
APP_URL=https://CHANGE_ME.example.com
# [REQUIRED] generate on the server:  php artisan key:generate --force
# Use a NEW key, never the one from your local machine.
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Manila
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---- HTTPS and security headers ----------------------------------------------
# Make every generated link https:// (works together with the redirect in
# public/.htaccess). Turn on the free SSL certificate in hPanel FIRST.
FORCE_HTTPS=true
# Browser must keep using HTTPS (HSTS). Set true only after you have confirmed
# the site works over HTTPS everywhere; browsers remember this.
SECURITY_HSTS=false
# Content-Security-Policy: report-only first (nothing breaks, violations show in
# the browser console). Switch to "enforce" after testing every screen.
SECURITY_CSP=report-only
# Leave empty on plain Hostinger shared hosting. If you put Cloudflare (or
# another proxy) in front, set TRUSTED_PROXIES=*  so real visitor IPs are used.
TRUSTED_PROXIES=

# ---- Logging -----------------------------------------------------------------
# One file per day, kept 14 days, warnings and errors only.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ---- Database (MySQL on Hostinger) -------------------------------------------
# Create the database AND a dedicated user in hPanel > Databases. Give that user
# access to this one database only. NEVER use a root account. Keep "Remote
# MySQL" switched off so the database is not reachable from the internet.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_u123456789_sclf
DB_USERNAME=CHANGE_ME_u123456789_sclf
DB_PASSWORD=CHANGE_ME_long_random_password

# ---- Session / cache / queue (no Redis on shared hosting) ---------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# [REQUIRED] cookies only travel over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
# Rate limits and 2FA lockouts live in the cache, so never use "array"/"null" here.
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- Mail (verification and password-reset emails) ---------------------------
# Hostinger email: create a mailbox in hPanel > Emails and use its details.
# Port 465 uses MAIL_SCHEME=smtps. Port 587 uses MAIL_SCHEME=smtp (STARTTLS).
# (Gmail also works but allows only ~500 emails a day and needs an app password.)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME@your-domain.com
MAIL_PASSWORD=CHANGE_ME_mailbox_password
MAIL_FROM_ADDRESS=CHANGE_ME@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Web push notifications --------------------------------------------------
# Generate a NEW pair on the server:  php artisan webpush:vapid
# (it writes the two keys below for you). VAPID_SUBJECT must be a mailto: or URL.
# NOTE: the browser app is built with the PUBLIC key baked in. If you generate
# new keys, rebuild the frontend (npm run build) and upload public/build again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:CHANGE_ME@your-domain.com"

# ---- First administrator (used once by: php artisan db:seed --class=AdminSeeder)
# After the admin has logged in and finished setup, DELETE these lines (or at
# least INITIAL_ADMIN_PASSWORD) from the server's .env.
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL=CHANGE_ME@your-domain.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_a_long_unique_password_12+
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_ID=
INITIAL_ADMIN_GENDER=

# ---- SCLF behaviour ----------------------------------------------------------
# Refresh token kept in an HttpOnly cookie that JavaScript cannot read (safer
# against script injection). Set false ONLY to go back to the old behaviour.
SCLF_REFRESH_COOKIE=true
# Right after upgrading, set this to true for ~30 days so people who are still
# signed in with the old storage are not forced to log in again, then remove it.
SCLF_REFRESH_ALLOW_BODY=false

# One active login per account.
SCLF_SINGLE_DEVICE_LOGIN=true
# Request log used for abuse detection (Admin > User Activity) and alerts.
SCLF_TRACK_ACTIVITY=true
SCLF_ACTIVITY_RETENTION_DAYS=90
SCLF_RETENTION_DAYS=90
SCLF_STAFF_APPROVAL_TTL_HOURS=24
SCLF_MATCH_ML=true

# Photo moderation (Google Vision). Leave false unless you have a key. With
# true and an empty key every photo scan fails and retries in the queue.
SCLF_MODERATION_ENABLED=false
SCLF_MODERATION_PROVIDER=google_vision
SCLF_MODERATION_API_KEY=
SCLF_MODERATION_THRESHOLD=LIKELY
SCLF_MODERATION_BLOCKED_WORDS=

# Profile and item photos are private; they are shown through signed links that
# last between 1x and 2x this many hours (see SECURITY_PHASES/PHASE_7.md).
SCLF_MEDIA_URL_TTL_HOURS=24

# ---- Suspicious-activity alerts (php artisan security:watch, every 10 min) ----
# Who gets the email (comma separated). Empty = every Admin account.
SECURITY_ALERT_EMAIL=
SECURITY_ALERT_FAILED_LOGINS=30
SECURITY_ALERT_FAILED_PER_IP=15
SECURITY_ALERT_SUSPICIOUS=10
SECURITY_ALERT_DENIED=100
SECURITY_ALERT_SERVER_ERRORS=5

# ---- Build-time only (used by `npm run build` on YOUR computer, ignored on server)
VITE_APP_NAME="${APP_NAME}"
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# Email ALL students/instructors when a lost item is approved (true/false).
SCLF_BROADCAST_LOST_ITEM_EMAILS=false
SCLF_BROADCAST_EMAILS_PER_SECOND=5
