<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # --- Force HTTPS (live server) -------------------------------------------
    # Everything except localhost is sent to https://. Works behind a proxy that
    # sets X-Forwarded-Proto too. Hostinger: enable the free SSL first.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Never serve hidden files or sensitive file types ---------------------
    # (.env, .git, .htpasswd, *.sql, *.log, *.bak ...). Letting
    # /.well-known/ through keeps SSL certificate renewal working.
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]
    RewriteRule "\.(env|sql|sqlite|log|bak|old|orig|swp|ini|lock|md)$" - [F,L,NC]

    # --- Browser caching for static files --------------------------------------
    # Vite names everything in /build/assets with a content hash, so a changed
    # file always gets a new name and the old one can be cached for a year.
    # /images has fixed names, so it only gets a week. Photos and attachments
    # served by Laravel set their own cache headers and are not touched here.
    RewriteRule ^build/assets/ - [E=SCLF_CACHE_LONG:1]
    RewriteRule ^images/ - [E=SCLF_CACHE_WEEK:1]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=SCLF_CACHE_LONG
    Header set Cache-Control "public, max-age=604800" env=SCLF_CACHE_WEEK
</IfModule>
