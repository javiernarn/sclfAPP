APP_NAME="SCLF - Opol Community College"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

SCLF_EMAIL_CHANGE_ENABLED=true
SCLF_STAFF_REQUIRES_APPROVAL=true
SCLF_MEDIA_URL_TTL_HOURS=24
SCLF_BROADCAST_LOST_ITEM_EMAILS=true
SCLF_BROADCAST_BATCH_SIZE=50
SCLF_SINGLE_DEVICE_LOGIN=true
SCLF_ONE_REPORT_PER_DAY=false
SCLF_MATCH_ML=true
SCLF_PRINT_OPEN_EMAILS=true
SCLF_TRACK_ACTIVITY=false
SCLF_SOURCEMAPS=false
SCLF_REFRESH_COOKIE=true
SCLF_REFRESH_ALLOW_BODY=false
SCLF_SYSTEM_MODE=false

VITE_ENABLE_INSPECT_PROTECTION=false
VITE_PHOTO_CHECK_ENABLED=true
VITE_PHOTO_CHECK_CONSOLE=false
PHOTO_CHECK_ENFORCE=true

SCLF_MODERATION_ENABLED=false
SCLF_MODERATION_PROVIDER=google_vision
SCLF_MODERATION_API_KEY=
SCLF_MODERATION_THRESHOLD=LIKELY
SCLF_MODERATION_BLOCKED_WORDS=

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sclf_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

INITIAL_ADMIN_NAME="Admin"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_PHONE=""
INITIAL_ADMIN_ID="ADMIN-00000000"
INITIAL_ADMIN_GENDER="male"

SECURITY_CSP=report-only
APP_SEASON=
